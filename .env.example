# Cloudflare Workers 版配置说明
# ============================================================================
# 本项目已从 Docker / Express 迁移到 Cloudflare Workers，机密不再通过 .env 注入，
# 而是使用 Wrangler 的 secret 机制写入 Cloudflare 账号：
#
#   npx wrangler secret put SESSION_SECRET
#   npx wrangler secret put SUPERADMIN
#   npx wrangler secret put SUPERADMINPASSWORD
#   npx wrangler secret put QINIU_ACCESS_KEY
#   npx wrangler secret put QINIU_SECRET_KEY
#
# 非机密变量请写入 wrangler.toml 的 [vars] 段（例如 ANONYMOUS_DAILY_UPLOAD_LIMIT）。
#
# 本地开发如需使用机密，请创建 .dev.vars（该文件已被 .gitignore 忽略），格式与
# 下面相同。切勿把真实密钥提交到仓库。
# ============================================================================

# ---- 会话与管理员（机密，用 wrangler secret put 写入） ----
SUPERADMIN=
SUPERADMINPASSWORD=
# 生产环境必须使用高熵随机值，否则 isolate 回收后会话会失效
# 生成方式：openssl rand -hex 32
SESSION_SECRET=

# ---- 匿名额度（非机密，可放 wrangler.toml 的 [vars]） ----
ANONYMOUS_DAILY_UPLOAD_LIMIT=500

# ---- 七牛图床：仅「复制到公众号」需要（机密） ----
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com
QINIU_PREFIX=notes
# 可选：指定上传入口；留空则使用七牛通用入口 upload.qiniup.com
# QINIU_UPLOAD_URL=
QINIU_UPLOAD_TIMEOUT_MS=30000

# ---- AI 辅助审阅（机密） ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# ---- 站点地址 ----
# 反向代理无法提供正确 Host 时显式指定
# NOTES_PUBLIC_BASE_URL=https://notes.example.com

# ---- 密码哈希迭代次数 ----
# Workers 免费版单请求 CPU 预算有限，默认 10000；调整不会使已有密码失效
# PBKDF2_ITERATIONS=10000
